{
  "name": "blastermasterultratppextension",
  "displayName": "BlasterMasterUltraTPPextension",
  "description": "Syntax highlighting for TPP lang",
  "publisher": "<your publisher name>",
  "repository": {
    "type": "git",
    "url": "https://github.com/EricSL07/blastermasterultratppextension.git"
  },
  "version": "0.0.1",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "tpp-icon",
        "label": "blastermasterultra icon",
        "path": "./icons/icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "TPPextension",
        "aliases": [
          "TPPextension",
          "TPPextension"
        ],
        "extensions": [
          ".tpp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "TPPextension",
        "scopeName": "source.tpp",
        "path": "./syntaxes/TPPextension.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs'),yaml=require('js-yaml');fs.writeFileSync('./syntaxes/TPPextension.tmLanguage.json',JSON.stringify(yaml.load(fs.readFileSync('./syntaxes/TPPextension.tmLanguage.yaml','utf8')),null,2))\""
  },
  "devDependencies": {
    "js-yaml": "^5.4.1"
  }
}
